# 复制为 .env 后填值。任何真实 .env 不得提交。
APP_ENV=dev
DJANGO_DEBUG=false
SECRET_KEY=change-me-openssl-rand-hex-32
JWT_SIGNING_KEY=change-me-rsa-or-hex

# --- Postgres ---
POSTGRES_DB=compsphere
POSTGRES_USER=compsphere
POSTGRES_PASSWORD=
DATABASE_URL=postgres://compsphere:CHANGE_ME@postgres:5432/compsphere

# --- Redis / Celery ---
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO / S3 ---
# Required: verify release/digest and curl availability for health checks before deployment.
MINIO_IMAGE=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
# Browser-reachable base URL, using a separate signing client; never rewrite a signed URL.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MEDIA=compsphere-media
S3_BUCKET_CERTS=compsphere-certs
S3_PRESIGN_TTL_SECONDS=900

# --- 证件字段加密（P0 必配，参赛成员身份证/护照二选一）---
# Fernet 密钥，生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 丢失即所有证件号不可恢复；轮换需跑重加密任务，禁止直接改值。
FIELD_ENCRYPTION_KEY=change-me-fernet-key
# 证件 HMAC-SHA256 的 pepper，与上面的密钥必须不同值；输入为 类型|签发国|规范化号码，用于匹配与查重。
# 轮换 pepper 会使 document_hash 全表失效，属破坏性变更（见 04 §8.2）。
DOC_HASH_PEPPER=change-me-openssl-rand-hex-32

# --- 邮件（验证码及业务邮件均经 outbox + Celery 异步投递）---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@compsphere.example
# 生产必须为 true：本地自签证书仅供 Mailpit 调试
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=5

# --- 邮箱验证码（自助注册与已验证邮箱找回；无邮箱代建走管理员核验重置）---
CODE_TTL_SECONDS=600
CODE_RESEND_INTERVAL_SECONDS=60
CODE_MAX_ATTEMPTS=5
CODE_IP_HOURLY_LIMIT=20

# --- 日志与可观测性（DEVELOPMENT.md §2）---
# 单条 SQL 超过该毫秒数记 WARNING 明细
LOG_SLOW_QUERY_MS=200
# 全量 SQL 明细：仅 dev 用 true，生产必须 false
LOG_SQL_ALL=false
# 请求耗时超过该毫秒数在访问日志标记 slow
LOG_SLOW_REQUEST_MS=800
# structlog 输出级别：DEBUG 仅本地
LOG_LEVEL=INFO

# --- 对外 ---
SITE_BASE_URL=http://localhost
HTTP_PORT=80
# 仅填写直接连接后端的受控Nginx IP/CIDR；Nginx必须覆盖X-Real-IP。
# 留空忽略转发头；禁止0.0.0.0/0，生产需配置为隔离代理地址。
TRUSTED_PROXY_IPS=
TZ=Asia/Shanghai

# 平台核验联系邮箱：部署时配置；无归属学生无法自助找回时展示，不用于自动重置。
SUPPORT_EMAIL=
