# 复制为 .env 后填值。任何真实 .env 不得提交。
APP_ENV=dev
DJANGO_DEBUG=false
SECRET_KEY=change-me-openssl-rand-hex-32
JWT_SIGNING_KEY=change-me-rsa-or-hex

# --- Postgres ---
POSTGRES_DB=compsphere
POSTGRES_USER=compsphere
POSTGRES_PASSWORD=
DATABASE_URL=postgres://compsphere:CHANGE_ME@postgres:5432/compsphere

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MEDIA=compsphere-media
S3_BUCKET_CERTS=compsphere-certs
S3_PRESIGN_TTL_SECONDS=900

# --- 身份证字段加密（v1.1 起 P0 必配，参赛成员必填）---
# Fernet 密钥，生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 丢失即所有身份证号不可恢复；轮换需跑重加密任务，禁止直接改值。
FIELD_ENCRYPTION_KEY=change-me-fernet-key
# 身份证哈希的 pepper，与上面的密钥必须不同值；用于跨表匹配与查重。
# 轮换 pepper 会使 id_number_hash 全表失效，属破坏性变更（见 04 §8.2）。
ID_HASH_PEPPER=change-me-openssl-rand-hex-32

# --- 邮件（Celery 发送注册验证码、审核/证书通知）---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@compsphere.example
# 生产必须为 true：本地自签证书仅供 Mailpit 调试
EMAIL_USE_TLS=true

# --- 邮箱验证码（v1.1，注册与找回密码唯一通道）---
CODE_TTL_SECONDS=600
CODE_RESEND_INTERVAL_SECONDS=60
CODE_MAX_ATTEMPTS=5

# --- 日志与可观测性（DEVELOPMENT.md §2）---
# 单条 SQL 超过该毫秒数记 WARNING 明细
LOG_SLOW_QUERY_MS=200
# 全量 SQL 明细：仅 dev 用 true，生产必须 false
LOG_SQL_ALL=false
# 请求耗时超过该毫秒数在访问日志标记 slow
LOG_SLOW_REQUEST_MS=800
# structlog 输出级别：DEBUG 仅本地
LOG_LEVEL=INFO

# --- 对外 ---
SITE_BASE_URL=http://localhost
HTTP_PORT=80
TZ=Asia/Shanghai
