{
  "name": "compsphere-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../docs/openapi.json -o src/api/generated.d.ts && prettier --write src/api/generated.d.ts",
    "format:check": "prettier --check src tests *.json *.ts index.html",
    "lint": "eslint src tests vite.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.21.1",
    "element-plus": "2.14.8",
    "pinia": "2.3.1",
    "vue": "3.5.45",
    "vue-i18n": "11.4.22",
    "vue-router": "4.6.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
